# Local SSO (Keycloak in Docker). Pick any two free ports.
KEYCLOAK_PORT=8080
KEYCLOAK_ADMIN_PASSWORD=change-me
OIDC_ISSUER=http://localhost:8080/realms/vardhan
OIDC_CLIENT_ID=kb-app
OIDC_CLIENT_SECRET=            # sso/setup_realm.py fills this in
APP_URL=http://localhost:8000
APP_PORT=8000

# LLM: Ollama locally. For a cloud model, point these at any OpenAI-compatible API.
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5:7b
LLM_API_KEY=ollama
